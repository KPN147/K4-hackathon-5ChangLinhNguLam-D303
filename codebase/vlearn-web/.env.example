# Server-only Gemini keys. Never expose these as NEXT_PUBLIC_* variables.
# Put multiple keys on one line; the server rotates through them on quota/error.
GEMINI_API_KEYS=key_1,key_2,key_3
GEMINI_MODEL=gemini-2.5-flash
# Legacy default for callers that do not choose a provider explicitly.
LLM_PROVIDER=vilao
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free

# Summary uses this OpenAI-compatible Vilao provider explicitly.
# Tutor uses the Google Gemini API explicitly via GEMINI_API_KEYS above.
VILAO_API_KEY=
VILAO_BASE_URL=https://api.vilao.ai/v1
VILAO_MODEL=ts/gemini-3.1-flash-lite

# Optional: exact retrieval endpoint owned by the document-pipeline service.
PIPELINE_RETRIEVAL_URL=
